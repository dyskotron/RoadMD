{
  "title": "ShooterReborn roadmap",
  "owner": "Matej",
  "board": "docs/ROADMAP.md",
  "page": "docs/roadmap.html",
  "nextSize": 5,
  "ids": { "pattern": "[A-Z]{2,12}-\\d+", "unordered": ["GDD", "NEBULA"] },
  "areas": { "pattern": "[A-Z]{2,5}" },
  "milestones": { "pattern": "M\\d+" },

  "states": [
    { "id": "backlog", "color": "#9ca3af", "darkColor": "#6b7280", "milestoneOptional": true,
      "meaning": "noted, its design still to be done",
      "work": { "id": "design", "label": "To design", "next": "Next to design", "needs": "tech",
                "lead": "In the backlog and everything it waits for has its game design. {count} of {open} open items." } },
    { "id": "design", "color": "#7c3aed", "active": true, "meaning": "the game design is being written" },
    { "id": "tech", "color": "#0d9488", "meaning": "the game design is settled; the tech design is to be written",
      "work": { "id": "tech", "label": "To tech-design", "next": "Next to tech-design", "needs": "ready",
                "lead": "Game design settled and everything it waits for has its tech design: Matej leads it with an agent.",
                "waiting": { "label": "Tech but waiting", "lead": "Game design settled, something it needs has no tech design yet." } } },
    { "id": "ready", "color": "#d97706", "meaning": "game and tech design settled and approved: an agent can take it",
      "requires": [ { "docKind": "tech", "review": "approved", "level": "warning" } ],
      "work": { "id": "build", "label": "To build", "next": "Next to build", "needs": "test",
                "lead": "Game and tech design settled and everything it waits for is built (merged into dev: test or done): an agent can take it.",
                "waiting": { "label": "Ready but waiting", "lead": "Game and tech design settled, something it needs isn't built yet." } } },
    { "id": "doing", "color": "#2563eb", "active": true, "earlierStages": "test", "meaning": "being built, in its branch" },
    { "id": "test", "color": "#db2777", "earlierStages": "test", "meaning": "built and merged, waiting for its test and the owner's look",
      "work": { "id": "test", "label": "To test", "lead": "Built, waiting for its test procedure and your look." } },
    { "id": "done", "color": "#16a34a", "darkColor": "#22c55e", "final": true, "meaning": "tested and accepted" }
  ],
  "inProgress": { "label": "In progress" },
  "overview": ["test", "inProgress", "next", "build", "tech", "design", "reviews"],
  "next": ["build", "tech", "design"],
  "boardOrder": ["doing", "test", "ready", "tech", "design", "backlog", "done"],

  "docs": {
    "include": ["docs/**/*.md", "CLAUDE.md", "Assets/Nebula/README.md", "Assets/Station/README.md"],
    "names": {
      "GDD": "docs/GameDesignDocument.md",
      "GDD_Review": "docs/GDD_Review.md",
      "Nebula README": "Assets/Nebula/README.md",
      "Station README": "Assets/Station/README.md",
      "CLAUDE.md": "CLAUDE.md"
    },
    "stemSuffixes": ["BUILD_PROMPT", "SPEC", "CHANGELOG", "QUESTIONS"],
    "minStemLength": 6,
    "anchors": [
      { "pattern": "\\*([^*]+)\\*", "anchor": "$1" },
      { "pattern": "§\\s*(\\d+)", "anchor": "$1." },
      { "pattern": "\\b(P\\d)\\b", "anchor": "$1" }
    ]
  },
  "docKinds": [
    { "id": "tech", "label": "Tech designs", "lead": "how each feature is built, one per feature",
      "match": "docs/tech/**", "displayName": "stem",
      "perItem": { "label": "Tech design", "path": "docs/tech/{feature}_TECH.md", "missing": "not written yet" },
      "review": {
        "files": "docs/tech/*_TECH.md",
        "line": "^> \\*\\*Review:\\*\\* (.+)$",
        "states": [
          { "id": "approved", "match": "^approved\\b", "ok": true, "color": "done" },
          { "id": "changed", "match": "^changed since review\\b", "label": "changed since review", "color": "ready" },
          { "id": "not reviewed", "default": true, "color": "backlog" }
        ],
        "overview": { "label": "Tech designs to review", "lead": "Not approved by you yet: {count} of {total}." },
        "index": { "file": "docs/tech/README.md", "start": "<!-- reviews:start -->", "end": "<!-- reviews:end -->", "header": ["Tech design", "Review"] }
      } },
    { "id": "design", "label": "Game design", "lead": "what the game and each feature are", "match": "docs/*.md" },
    { "id": "other", "label": "Other", "lead": "build prompts, notes and readmes", "match": "**" }
  ],
  "linkedDocsLabel": "Game design"
}
